# Google Gemini API Configuration
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# Google Sheets Configuration
# Get the Sheet ID from the URL: https://docs.google.com/spreadsheets/d/SHEET_ID/edit
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_CREDENTIALS_FILE=credentials.json

# Google Sheets API Scopes
# This scope allows read and write access to Google Sheets
GOOGLE_SHEETS_SCOPE=https://www.googleapis.com/auth/spreadsheets

# Telegram Bot Configuration
# Get your bot token from BotFather on Telegram: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Get your bot handle from BotFather on Telegram: https://t.me/BotFather
TELEGRAM_BOT_HANDLE=your_telegram_bot_handle_here